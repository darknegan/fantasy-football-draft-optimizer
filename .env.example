# Root secrets for Cloudflare deploys (Wrangler). Copy to `.env` and fill in.
# Never commit `.env` — it is gitignored.
#
# Also set the same values as GitHub repository secrets on this repo
# (Settings → Secrets and variables → Actions) so `.github/workflows/deploy-web.yml`
# can auto-deploy on merge to main:
#   CLOUDFLARE_API_TOKEN  — Account → Workers Scripts → Edit
#   CLOUDFLARE_ACCOUNT_ID — below

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=247649a81d4e45d2f6dc4fe1ea615e75
