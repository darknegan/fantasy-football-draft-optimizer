# Copy to apps/api/.env — loaded automatically by `npm run dev:api` / `start` / tests.
# Never commit .env (gitignored).

# Local Docker Postgres (docker compose up -d postgres):
# DATABASE_URL=postgresql://draftlab:draftlab@127.0.0.1:5432/draftlab
#
# Supabase project "draftlab" (mvuwjtlcvsoamasbuirf) — preferred for shared/dev cloud:
# Dashboard password: https://supabase.com/dashboard/project/mvuwjtlcvsoamasbuirf/settings/database
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.mvuwjtlcvsoamasbuirf.supabase.co:5432/postgres?sslmode=require
JWT_ACCESS_SECRET=replace-with-at-least-32-char-access-secret
JWT_REFRESH_SECRET=replace-with-at-least-32-char-refresh-secret
CORS_ORIGINS=http://localhost:4200
AUTH_COOKIE_SECURE=false
PORT=3001
HOST=0.0.0.0
# Optional local demos owned by a dedicated user
SEED_DEMO_USER=false
DEMO_USER_EMAIL=demo@draftlab.local
DEMO_USER_PASSWORD=demopassword
