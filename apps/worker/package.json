{
  "name": "@draftlab/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --use-system-ca ../../node_modules/wrangler/bin/wrangler.js dev",
    "deploy": "node --use-system-ca ../../node_modules/wrangler/bin/wrangler.js deploy",
    "types": "node --use-system-ca ../../node_modules/wrangler/bin/wrangler.js types",
    "cf-typegen": "npm run types",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@draftlab/auction-engine": "*",
    "@draftlab/calibration-engine": "*",
    "@draftlab/domain": "*",
    "@draftlab/dynasty-engine": "*",
    "@draftlab/evaluation-engine": "*",
    "@draftlab/integrations": "*",
    "@draftlab/recommendation-engine": "*",
    "@draftlab/strategy-engine": "*",
    "hono": "^4.9.6",
    "jose": "^6.2.8"
  },
  "devDependencies": {
    "typescript": "~5.9.2",
    "wrangler": "^4.90.1"
  }
}
