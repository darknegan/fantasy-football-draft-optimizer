{
  "name": "@draftlab/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "wrangler": "node --use-system-ca ../../node_modules/wrangler/bin/wrangler.js",
    "dev": "npm run wrangler -- dev",
    "deploy": "npm run wrangler -- deploy",
    "types": "npm run wrangler -- types",
    "cf-typegen": "npm run types",
    "login": "npm run wrangler -- login",
    "r2:create": "npm run wrangler -- r2 bucket create draftlab-artifacts",
    "r2:list": "npm run wrangler -- r2 bucket list",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@draftlab/auction-engine": "*",
    "@draftlab/calibration-engine": "*",
    "@draftlab/domain": "*",
    "@draftlab/dynasty-engine": "*",
    "@draftlab/evaluation-engine": "*",
    "@draftlab/integrations": "*",
    "@draftlab/recommendation-engine": "*",
    "@draftlab/strategy-engine": "*",
    "@supabase/supabase-js": "^2.112.2",
    "hono": "^4.9.6",
    "jose": "^6.2.8",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "typescript": "~5.9.2",
    "wrangler": "^4.90.1"
  }
}
